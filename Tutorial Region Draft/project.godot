;   param=value ; assign values to parameters

config_version=5

[application]

config/name="An Untitled Action Adventure RPG"
run/main_scene="uid://nu4reo7kkn10"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GlobalVisualManagement="*res://00_Globals/global_visual_management.gd"
GlobalLevelManagement="*uid://b4862palyhoyr"
GlobalPlayerManagement="*uid://coars3ovefi1y"
GlobalSaveManagement="*uid://ckvvwckxr6w6p"
GlobalAudioManagement="*uid://55cxifju4k2r"
SceneTransition="*uid://coyi36vx6eypn"
PauseMenu="*uid://58ymop2qxnbg"

[display]

window/size/initial_position=Vector2i(512, 512)
window/size/initial_screen=512
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray()

[global_group]

Player="A global group for the player"

